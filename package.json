{
  "name": "ura",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "node scripts/migrate.mjs",
    "e2e:db": "node scripts/prepare-e2e-db.mjs",
    "db:reset": "node scripts/reset-dev-db.mjs",
    "test": "vitest run",
    "e2e": "pnpm e2e:db && playwright test",
    "e2e:browsers": "playwright install chromium",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "pnpm e2e",
    "verify": "pnpm typecheck && pnpm test:unit && pnpm test:integration",
    "instrument:seed": "node scripts/seed-instrument.mjs && node scripts/seed-severity.mjs && node scripts/seed-tier3.mjs",
    "agent-map": "node scripts/build-agent-map.mjs",
    "uat:new": "node scripts/uat-skeleton.mjs",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo:finished": "node scripts/seed-finished.mjs",
    "demo:reset": "node scripts/reset-dev-db.mjs --yes && node scripts/seed-demo.mjs && node scripts/seed-finished.mjs",
    "demo:prod": "NEXT_DIST_DIR=.next-prod next build && cp -r public .next-prod/standalone/ 2>/dev/null; cp -r .next-prod/static .next-prod/standalone/.next-prod/ 2>/dev/null; PORT=3100 NEXT_DIST_DIR=.next-prod node .next-prod/standalone/server.js",
    "walk:demo": "node scripts/walk-demo.mjs",
    "dev:ai": "node scripts/dev-ai.mjs",
    "agent:install": "pnpm --dir agent install",
    "agent:dev": "node scripts/agent.mjs",
    "agent:claude": "node scripts/agent.mjs claude",
    "dev:claude": "node scripts/dev-ai.mjs --claude",
    "agent:ollama": "node scripts/agent.mjs ollama",
    "agent:test": "cd agent && vitest run",
    "ai:check": "node --experimental-strip-types scripts/ai-check.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "mammoth": "^1.12.1",
    "next": "^15.3.9",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.1",
    "@playwright/test": "^1.54.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
