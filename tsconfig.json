{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-e2e/types/**/*.ts",
    ".next-prod/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-verify/types/**/*.ts"
  ],
  // scripts/ holds plain .mjs (hooks run under bare node, no build step),
  // which allowJs:false already ignores. Only its .d.ts files are wanted —
  // the shared slice parser is imported by tests (enforcement-layer
  // verification, gate 2).
  // agent/ is a separate service with its own tsconfig, its own
  // dependencies and its own image. It is in this repository because it
  // shares the wire contract, not because it is part of this build.
  "exclude": [
    "node_modules",
    "agent"
  ]
}
