node_modules/
.next/
.env
*.tsbuildinfo
test-results/
playwright-report/
.claude/settings.local.json

# Throwaway verification scripts — never committed (G-28 wave, F7)
.verify-*.mjs
.diag*.mjs
.chip-*.mjs
.next-e2e/

# Generated by Next on every dev/build, and it points at whichever dist dir
# ran last — dev's .next or the e2e suite's .next-e2e. Committing it means a
# spurious diff after every test run; `pnpm typecheck` passes without it.
next-env.d.ts

# Subagent worktrees — isolated copies, never part of the repo
.claude/worktrees/

# macOS junk, and the extra build dirs the prod/verify scripts create.
.DS_Store
.next-prod/
.next-verify/

# Audit run logs. The report's own evidence — inventory.json, traceability,
# tally, e2e.log and the findings CSV — IS tracked, because a document that
# cites a path nobody can open is the finding it was written to avoid. These
# are the ad-hoc captures behind it, regenerable by re-running the tools.
audit/gates*.log
audit/gates.txt
audit/e2e-floor.log
audit/inventory.txt
audit/practices.txt
audit/requirements.txt
audit/deadcode-knip.txt
