DATABASE_URL=postgres://ura:ura@localhost:5432/ura
E2E_DATABASE_URL=postgres://ura:ura@localhost:5432/ura_e2e

# The agent is a separate service and is OFF by default. With none connected
# the product says so rather than implying one runs, so the app is fully
# usable without any of this.
#
# To run it against Claude:
#   1. put your own key below — it is billed to whoever's key it is
#   2. `pnpm agent:claude`  (starts the agent on 8790, reading this file)
#   3. `pnpm dev`           (the web app, already pointed at 8790)
#
# Nothing here needs administrator rights. This is an ordinary file in the
# project folder; no system keychain, no PATH change, no global install.
ANTHROPIC_API_KEY=
AGENT_TRANSPORT=local
AGENT_URL=http://localhost:8790

# Optional. Defaults to claude-sonnet-5.
# AGENT_MODEL=claude-sonnet-5

