# Normalise line endings so a checkout on Windows does not rewrite every
# file and produce a diff nobody made.
* text=auto eol=lf

# Generated by `pnpm agent-map`, not written by hand. Marking them keeps
# GitHub's language bar honest — otherwise a 160 KB generated page makes
# this look like an HTML project — and collapses them in diffs, where a
# regenerated file is noise rather than a change to read.
docs/agent-map.html linguist-generated=true
src/data/agents.json linguist-generated=true

# Lockfiles: real, tracked, and never worth reading in a diff.
pnpm-lock.yaml linguist-generated=true
agent/pnpm-lock.yaml linguist-generated=true
